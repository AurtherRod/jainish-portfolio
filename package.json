{
  "name": "jainish-portfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:compress": "react-scripts build && gzip -k -f build/static/js/*.js build/static/css/*.css 2>/dev/null || true",
    "build:analyze": "npm run build && source-map-explorer 'build/static/js/*.js'",
    "optimize:images": "node scripts/convertToWebP.js",
    "optimize:critical": "node scripts/extractCritical.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "cd backend && npm run dev",
    "server:install": "cd backend && npm install",
    "server:seed": "cd backend && npm run seed",
    "dev": "npm-run-all --parallel start server",
    "install:all": "npm install && npm run server:install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
