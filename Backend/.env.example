# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/jainish-portfolio
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/jainish-portfolio

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Admin Configuration (for initial setup)
ADMIN_EMAIL=admin@jainish.space
ADMIN_PASSWORD=change-this-password

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Hostinger SMTP Configuration (for syllabus email)
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_EMAIL=your-email@yourdomain.com
HOSTINGER_EMAIL_PASS=your-email-password
